# ==========================================
# GEMINI AI STUDIO CONFIGURATION
# ==========================================
# Obtén tu API Key gratuita en https://aistudio.google.com/
GEMINI_API_KEY="AIzaSy..."

# ==========================================
# HUBSPOT CRM CONFIGURATION
# ==========================================
# Token de HubSpot Private App con scopes:
# - crm.objects.contacts.read
# - crm.objects.deals.read
HUBSPOT_ACCESS_TOKEN="pat-na1-..."

# ==========================================
# GOOGLE CALENDAR (SERVICE ACCOUNT) CONFIGURATION
# ==========================================
# Correo de la Service Account creada en Google Cloud Console
GOOGLE_SERVICE_ACCOUNT_EMAIL="calendar-assistant@tu-proyecto.iam.gserviceaccount.com"

# Clave privada RSA obtenida del archivo JSON de la Service Account.
# En Vercel o archivo .env, asegúrate de mantener las líneas o usar "\n" para los saltos de línea.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC3...\n-----END PRIVATE KEY-----\n"

# ID del Google Calendar personal (normalmente tu dirección de email de Google o un ID específico de calendario)
# IMPORTANTE: Debes compartir tu calendario personal con el GOOGLE_SERVICE_ACCOUNT_EMAIL dándole permisos de ver detalles.
GOOGLE_CALENDAR_ID="tu-email@gmail.com"
